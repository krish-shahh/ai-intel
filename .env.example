# Copy this file to .env for local runs. Never commit .env or real credentials.
# The sweep script loads these values from .env without overriding exported values.
# GitHub Actions cannot read this local file: configure the marked values separately
# under Repository Settings > Secrets and variables > Actions.

# Required by SEC EDGAR: include an app name and reachable contact email.
# GitHub Actions: repository variable SEC_USER_AGENT.
SEC_USER_AGENT=ai-intel your-email@example.com

# Jev structured relevance/topic scoring (TypeSafe console API key).
# GitHub Actions: repository secret TYPESAFE_API_KEY.
TYPESAFE_API_KEY=
JEV_MAX_ITEMS_PER_SWEEP=100
JEV_MIN_RELEVANCE_SCORE=2

# Optional Reddit OAuth source adapter.
# GitHub Actions: repository secrets REDDIT_CLIENT_ID and REDDIT_CLIENT_SECRET.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional news aggregators; both are disabled when the key is blank.
# GitHub Actions: repository secrets NEWSAPI_KEY and MEDIASTACK_KEY.
NEWSAPI_KEY=
MEDIASTACK_KEY=

# Optional authenticated GitHub API calls during local sweeps.
# GitHub Actions provides its own GITHUB_TOKEN automatically.
GITHUB_TOKEN=

# Optional local/manual trigger for the API-only Claude routine.
# GitHub Actions: repository secret CLAUDE_AI_INTEL_ROUTINE_FIRE_TOKEN.
# This routine token is shown only once when created; do not commit it.
CLAUDE_AI_INTEL_ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_013QRJRw6QVAX6B25b3Mxcgy/fire
CLAUDE_AI_INTEL_ROUTINE_FIRE_TOKEN=
